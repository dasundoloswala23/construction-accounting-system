# Firebase web config (not secret - safe to expose in a client bundle).
# For local development against the emulator suite, these can stay as the
# placeholder values below; the emulators don't validate them. Only real
# values are needed once you point this app at a live Firebase project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-waterman-erp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-waterman-erp
VITE_FIREBASE_STORAGE_BUCKET=demo-waterman-erp.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Set to "true" to connect the app to the local Firebase Emulator Suite
# (firebase emulators:start) instead of live Firebase services.
VITE_USE_FIREBASE_EMULATORS=true
